# ==============================================================================
# ClauseLens Environment Configuration
# ==============================================================================

# LLM Provider: 'gemini' or 'openai' (defaults to 'gemini' if GEMINI_API_KEY is present)
LLM_PROVIDER=gemini

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.0-flash

# OpenAI API Configuration (alternative)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

# Offline Demo Mode: when true, serves cached synthetic benchmark results with 0 API calls
DEMO_MODE=false

# Backend Port
PORT=8000

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

